    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Menu Principal" />

    <Button onAction="#cadastrarCliente" styleClass="botao" text="Cadastrar Cliente." />

    <Button onAction="#cadastrarVeiculo" styleClass="botao" text="CARROS" />

    <Button onAction="#ordenDeServico" styleClass="botao" text="ORDENS DE SERVIÇO" />

</VBox>
