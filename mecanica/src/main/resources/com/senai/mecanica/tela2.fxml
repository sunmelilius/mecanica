<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="tela"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.mecanica.Tela2Controller">

    <padding>
        <Insets bottom="40.0"
                left="40.0"
                right="40.0"
                top="40.0"/>
    </padding>

    <Label text="Menu Principal"/>

    <Button text="Cadastrar Cliente."
            styleClass="botao"
            onAction="#cadastrarCliente"/>

    <Button text="CARROS"
            styleClass="botao"/>

    <Button text="ORDENS DE SERVIÇO"
            styleClass="botao"/>

</VBox>